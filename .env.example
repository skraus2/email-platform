# Local development defaults. Copy to .env to override (`.env` is gitignored).
# These credentials are for the local Docker Compose database only — never
# reuse them anywhere else. No AWS / SES settings exist yet by design.

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s

# Host port of the Compose PostgreSQL (54320 avoids clashing with a local 5432).
POSTGRES_PORT=54320
DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/email_platform?sslmode=disable

# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/postgres?sslmode=disable

# Mail dispatch: only the local Mailpit sink is supported. Non-local SMTP hosts
# are rejected at startup, and the server must identify as Mailpit or nothing
# is sent. Never enable relaying (MP_SMTP_RELAY_*) on that Mailpit: it would
# forward real mail.
MAIL_PROVIDER=mailpit
SMTP_ADDR=127.0.0.1:1025
PROVIDER_TIMEOUT=10s
BODY_MAX_AGE=168h

# Dispatch retries: attempts per email (set by the API on each new job) and
# capped exponential backoff with jitter between them (worker). The whole
# schedule must fit into BODY_MAX_AGE; give API and worker the same values.
SEND_MAX_ATTEMPTS=8
RETRY_BASE_DELAY=30s
RETRY_MAX_DELAY=1h

# Accepted sends per project and minute (API). Over the limit: 429 with
# Retry-After. Refused requests and idempotent replays do not count.
API_RATE_LIMIT_PER_MINUTE=600

# Messages per second the worker hands to the provider (per worker process;
# burst = rate). Jobs over the budget wait up to 1s or are snoozed.
PROVIDER_RATE_PER_SECOND=10
