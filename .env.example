# Local development defaults. Copy to .env to override (`.env` is gitignored).
# These credentials are for the local Docker Compose database only — never
# reuse them anywhere else. Amazon SES stays off unless the complete opt-in
# below is set; no AWS value has a default.

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s

# Host port of the Compose PostgreSQL (54320 avoids clashing with a local 5432).
POSTGRES_PORT=54320
DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/email_platform?sslmode=disable

# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/postgres?sslmode=disable

# Mail dispatch: the local Mailpit sink (SES only with the opt-in below). Non-local SMTP hosts
# are rejected at startup, and the server must identify as Mailpit or nothing
# is sent. Never enable relaying (MP_SMTP_RELAY_*) on that Mailpit: it would
# forward real mail.
MAIL_PROVIDER=mailpit
SMTP_ADDR=127.0.0.1:1025
PROVIDER_TIMEOUT=10s
BODY_MAX_AGE=168h

# Retention (worker, checked hourly): email events (at least 360h, above the
# 14-day SQS redelivery window) and finished webhook deliveries (at least
# 24h) are deleted after these ages; events still needed by a pending
# delivery or an unfinished email are kept. EMAIL_RETENTION is off (empty =
# keep emails forever); set it (at least 720h) to delete finished emails
# with their events and deliveries. Suppressions are never deleted. Expired
# admin sessions are always deleted. A complaint or permanent bounce
# reported after its email was deleted still suppresses the address SES names.
EVENT_RETENTION=2160h
WEBHOOK_DELIVERY_RETENTION=720h
# EMAIL_RETENTION=

# Amazon SES (off by default). Sending through SES needs every one of these;
# with MAIL_PROVIDER=mailpit any SES_* / SQS_ENDPOINT setting is a startup
# error. SES mode always requires verified senders (REQUIRE_VERIFIED_SENDER
# cannot be false). Credentials come from the default AWS chain (IAM role,
# environment, shared files) and are never configured here.
# MAIL_PROVIDER=ses
# SES_ENABLED=true
# AWS_REGION=eu-central-1
# SES_CONFIGURATION_SET=
# The worker long-polls this queue for SES events. They must arrive through
# the SNS topic below (signature version 2, raw delivery off) and be sent by
# the topic's own AWS account; anything else is logged and dropped. Give the
# queue a redrive policy (dead-letter queue) for messages that keep failing.
# SES_EVENTS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
# SES_EVENTS_TOPIC_ARN=arn:aws:sns:<region>:<account>:<topic>
# Required against AWS: the SDK must ignore AWS_ENDPOINT_URL* and profile
# endpoint_url settings, which could redirect signed requests (including the
# credential requests to STS/SSO) to another host.
# AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true
# Local stubs only (loopback host, refused in production); with an endpoint
# fixed fake credentials are used, never the default chain.
# SES_ENDPOINT=http://127.0.0.1:4566
# SQS_ENDPOINT=http://127.0.0.1:4566

# Messages all workers together hand to the provider per rolling 24 hours
# (0 = off). Set it to the SES daily sending quota (sandbox: 200) so jobs wait
# instead of failing with provider_throttled. Over the cap jobs are snoozed
# until a slot frees; concurrent workers can overshoot by their concurrency.
PROVIDER_DAILY_LIMIT=0

# Dispatch retries: attempts per email (set by the API on each new job) and
# capped exponential backoff with jitter between them (worker). The whole
# schedule must fit into BODY_MAX_AGE; give API and worker the same values.
SEND_MAX_ATTEMPTS=8
RETRY_BASE_DELAY=30s
RETRY_MAX_DELAY=1h

# Accepted sends per project and minute (API). Over the limit: 429 with
# Retry-After. Refused requests and idempotent replays do not count.
API_RATE_LIMIT_PER_MINUTE=600

# Template caps (API): templates per project, immutable versions per
# template, and bytes of template source and schemas a project may store.
TEMPLATE_MAX_PER_PROJECT=200
TEMPLATE_MAX_VERSIONS=500
TEMPLATE_MAX_STORAGE_BYTES=52428800
# Template creates/publishes per project and minute (every attempt counts;
# over the limit: 429 with Retry-After).
TEMPLATE_WRITES_PER_MINUTE=60

# Contacts (API): at most this many contacts per project, audiences per
# project and contacts per audience.
CONTACT_MAX_PER_PROJECT=250000
AUDIENCE_MAX_PER_PROJECT=100
AUDIENCE_MAX_CONTACTS=100000

# How far ahead a send (scheduled_at) may be planned, at most 720h, and how
# many planned sends of a project may wait at once. Content of a planned
# email is kept until it is due (then at most BODY_MAX_AGE longer).
SCHEDULE_MAX_AHEAD=720h
SCHEDULE_MAX_OPEN=10000

# Broadcasts (API): at most this many broadcasts of a project in draft,
# scheduled or sending at once.
BROADCAST_MAX_OPEN=20
# Broadcast creates per project and hour (cancelled broadcasts stay stored).
BROADCAST_CREATES_PER_HOUR=100

# Automations per project that are not archived, and automation creates per
# project and hour (archived automations stay stored).
AUTOMATION_MAX_PER_PROJECT=50
AUTOMATION_CREATES_PER_HOUR=100
# Contact events (automation triggers) per project and minute.
CONTACT_EVENT_RATE_PER_MINUTE=1200
# Contact events (and finished runs of automations that allow re-entry) are
# deleted after this age (at least 24h).
CONTACT_EVENT_RETENTION=2160h
# Automation steps the worker runs at once.
AUTOMATION_CONCURRENCY=4

# Messages per second the worker hands to the provider (per worker process;
# burst = rate rounded down, at least 1). Jobs over the budget wait up to 1s
# or are snoozed.
PROVIDER_RATE_PER_SECOND=10

# Sender identities: with true, the API accepts only from addresses that match
# a verified address or domain identity of the project (`admin sender add`,
# `admin sender verify`); others get 422 sender_not_verified.
REQUIRE_VERIFIED_SENDER=false

# Webhook endpoint secrets are stored AES-256-GCM encrypted under these
# key-encryption keys: "<id>:<base64 of 32 random bytes>[,<old id>:<base64>]",
# first entry active, older entries only decrypt (run `admin webhook
# reencrypt` before removing one). Generate a key with
#   openssl rand -base64 32
# Never commit a real value; no default exists on purpose. The worker refuses
# to start without it.
# Giving it to the API process as well enables POST /v1/webhook-endpoints
# (keys with the webhooks:write scope register their own endpoints); without
# it that route answers 503 webhook_registration_disabled. A compromised API
# holding it could decrypt every endpoint secret, so leave it unset for the
# API unless self-registration is needed, and beware that one env file shared
# by all processes enables it. Where the API has it, it must be exactly the
# worker's value; to rotate, give the new keyring to API, worker and admin
# CLI, restart them, run `admin webhook reencrypt`, then drop the old key.
# WEBHOOK_KEKS=
# Plain-http and loopback/private webhook targets: both allowed by default
# outside production; in production http is refused and private targets need
# an explicit true. Leave these unset to get those defaults.
# WEBHOOK_ALLOW_HTTP=
# WEBHOOK_ALLOW_PRIVATE=
# Webhook endpoints per project, active and disabled (disabling does not free
# a slot; reuse one with `admin webhook rotate-secret`).
WEBHOOK_MAX_ENDPOINTS_PER_PROJECT=10

# Webhook delivery (worker): requests per delivery, one request's timeout
# (at most 60s), parallel deliveries (own queue, never taking send slots) and
# capped exponential backoff with jitter between attempts. With the defaults a
# delivery is given up after about 5 hours; timeouts, connection errors, 408,
# 429 and 5xx are retried, any other status fails at once.
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_TIMEOUT=10s
WEBHOOK_CONCURRENCY=5
WEBHOOK_RETRY_BASE_DELAY=30s
WEBHOOK_RETRY_MAX_DELAY=1h

# A dispatch job still running this long belongs to a dead worker and is
# retried (at least PROVIDER_TIMEOUT + 60s).
JOB_RESCUE_AFTER=5m

# Operator (dashboard) API on its own listener; "off" disables it. In
# production only a loopback IP is accepted (no TLS on this listener).
ADMIN_HTTP_ADDR=127.0.0.1:8081
# The API serves Prometheus metrics at GET /metrics on that listener (no
# session; aggregate data only). The worker serves its own on METRICS_ADDR
# (empty = off; in production only a loopback IP is accepted).
# METRICS_ADDR=127.0.0.1:9091

# Dashboard admin sessions: end after this long without use, and at the
# latest this long after login. Accounts: `make admin ARGS="user create
# -username <name>"` (password from stdin).
ADMIN_SESSION_IDLE=30m
ADMIN_SESSION_MAX=12h

# Dashboard (server side only): where its server components reach the admin
# API. Never exposed to browsers.
ADMIN_API_URL=http://127.0.0.1:8081
