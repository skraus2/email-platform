# Local development defaults. Copy to .env to override (`.env` is gitignored).
# These credentials are for the local Docker Compose database only — never
# reuse them anywhere else. No AWS / SES settings exist yet by design.

APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s

# Host port of the Compose PostgreSQL (54320 avoids clashing with a local 5432).
POSTGRES_PORT=54320
DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/email_platform?sslmode=disable

# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://email_platform:email_platform@localhost:54320/postgres?sslmode=disable
