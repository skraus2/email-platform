{
  "name": "@email-platform/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side client for the Email Platform /v1 API",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "generate": "node scripts/generate.mts",
    "generate:check": "node scripts/generate.mts --check",
    "check:types-only": "node scripts/check-types-only.mts",
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/check-exports.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.mts'"
  },
  "devDependencies": {
    "@redocly/openapi-core": "1.34.22",
    "@types/node": "^26",
    "eslint": "^10",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
