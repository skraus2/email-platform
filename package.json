{
  "name": "email-platform",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --log-level warn --write",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --log-level warn --check"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
