# Build context of apps/dashboard/Dockerfile (the repository root): only the
# workspace manifests and the dashboard sources.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/dashboard
apps/dashboard/node_modules
apps/dashboard/.next
apps/dashboard/test-results
apps/dashboard/e2e
apps/dashboard/tsconfig.tsbuildinfo
apps/dashboard/playwright.config.ts
apps/dashboard/.env*
