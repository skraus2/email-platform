#!/usr/bin/env bash
# Renders the runtime environment of the production stack from AWS SSM
# Parameter Store (SecureString parameters under one path) into a file only
# root can read, on tmpfs, before `docker compose up`. Credentials come only
# from the instance role (IMDSv2): credential, profile, web-identity,
# container-credential and endpoint variables are refused, and the AWS CLI
# runs without shared config or credential files. Values are never printed.
#
#   AWS_REGION=<region> deploy/bin/render-env
#
#   SSM_PREFIX   parameter path (default /email-platform/prod/); the name
#                after the prefix is the variable name (UPPER_SNAKE_CASE)
#   APP_ENV_FILE output file (default /run/email-platform/app.env)
set -euo pipefail
umask 077

prefix="${SSM_PREFIX:-/email-platform/prod/}"
out="${APP_ENV_FILE:-/run/email-platform/app.env}"
required=(DATABASE_URL WEBHOOK_KEKS)

die() {
  echo "render-env: $*" >&2
  exit 1
}

for v in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE \
  AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN \
  AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_CREDENTIALS_RELATIVE_URI \
  AWS_CONTAINER_AUTHORIZATION_TOKEN AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE AWS_EC2_METADATA_SERVICE_ENDPOINT; do
  [[ -z "${!v:-}" ]] || die "$v is set; credentials must come from the instance role only"
done
for v in $(compgen -e); do
  [[ "$v" != AWS_ENDPOINT_URL* ]] || die "$v is set; the SSM endpoint must not be overridden"
done
[[ "${AWS_EC2_METADATA_DISABLED:-}" != true ]] || die "AWS_EC2_METADATA_DISABLED=true leaves no instance role"
[[ -n "${AWS_REGION:-}" ]] || die "AWS_REGION is not set"
[[ "$prefix" =~ ^/[A-Za-z0-9_./-]*/$ ]] || die "SSM_PREFIX must be a path like /email-platform/prod/"

dir="$(dirname "$out")"
mkdir -p -m 700 "$dir"
tmp="$(mktemp "$dir/.app.env.XXXXXX")"
trap 'rm -f "$tmp" "$tmp.raw" "$tmp.err"' EXIT

# Name<TAB>Value per line (the CLI follows pagination itself).
# No shared config or credentials files (a forgotten `aws configure` would
# otherwise win over the instance role), no configured endpoints, IMDSv2 only,
# no proxy and no custom CA bundle between the CLI and SSM. The output goes
# through a pipe: the snap-packaged CLI writes nothing to a redirected file
# under /run and still exits 0 (pipefail keeps the CLI's exit status).
if ! env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy -u ALL_PROXY -u all_proxy -u AWS_CA_BUNDLE \
  AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_CONFIG_FILE=/dev/null AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true \
  AWS_EC2_METADATA_V1_DISABLED=true aws ssm get-parameters-by-path --region "$AWS_REGION" --path "$prefix" --recursive --with-decryption \
  --query 'Parameters[].[Name,Value]' --output text 2>"$tmp.err" | cat >"$tmp.raw"; then
  # The CLI's error names the call, never parameter values.
  head -3 "$tmp.err" >&2
  rm -f "$tmp.raw" "$tmp.err"
  die "reading $prefix failed"
fi
rm -f "$tmp.err"

names=()
has() { [[ " ${names[*]:-} " == *" $1 "* ]]; }
line=0
# Messages name only validated variable names or line numbers: a line that is
# not "<prefix><NAME><TAB>" may be the continuation of a multi-line value.
while IFS=$'\t' read -r name value; do
  line=$((line + 1))
  [[ -n "$name" ]] || { rm -f "$tmp.raw"; die "output line $line is empty (a value with a line break)"; }
  key="${name#"$prefix"}"
  [[ "$name" == "$prefix$key" && "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || {
    rm -f "$tmp.raw"
    die "output line $line is not $prefix<UPPER_SNAKE_CASE><TAB>value (a parameter name, or a value with a line break)"
  }
  [[ "$key" != AWS_* || "$key" == AWS_REGION ]] || { rm -f "$tmp.raw"; die "$key must not be a parameter: AWS credentials come from the instance role"; }
  ! has "$key" || { rm -f "$tmp.raw"; die "$key is defined twice"; }
  [[ -n "$value" && "$value" != "None" ]] || { rm -f "$tmp.raw"; die "$key is empty"; }
  # Compose env files take single-quoted values literally.
  [[ "$value" != *"'"* ]] || { rm -f "$tmp.raw"; die "$key contains a single quote"; }
  printf "%s='%s'\n" "$key" "$value" >>"$tmp"
  names+=("$key")
done <"$tmp.raw"
rm -f "$tmp.raw"

for key in "${required[@]}"; do
  has "$key" || die "required parameter $prefix$key is missing"
done

chmod 600 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
if [[ "$(uname -s)" == Linux && "$(stat -f -c %T "$dir" 2>/dev/null)" != tmpfs ]]; then
  echo "render-env: warning: $dir is not on tmpfs; the secrets are on disk" >&2
fi
echo "render-env: wrote ${#names[@]} variables to $out: ${names[*]:-}"
