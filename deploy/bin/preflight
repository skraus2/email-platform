#!/usr/bin/env bash
# Checks, before `docker compose up`, that everything the production stack
# reads from the VM is in place. Prints names, never values. Run as root.
#   APP_ENV_FILE       rendered runtime env (default /run/email-platform/app.env)
#   DB_CA_FILE         CA bundle for DATABASE_URL sslrootcert (default /etc/email-platform/rds-ca.pem)
#   ALERT_SECRETS_DIR  holds webhook-url, the alert receiver (default /etc/email-platform/alertmanager)
#   API_DOMAIN, ACME_EMAIL  for Caddy
set -euo pipefail

compose="$(cd "$(dirname "$0")/.." && pwd)/compose.yaml"
env_file="${APP_ENV_FILE:-/run/email-platform/app.env}"
ca_file="${DB_CA_FILE:-/etc/email-platform/rds-ca.pem}"
alert_file="${ALERT_SECRETS_DIR:-/etc/email-platform/alertmanager}/webhook-url"
problems=0
bad() { echo "preflight: $*" >&2; problems=$((problems + 1)); }

mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
# First value of a query parameter, as Go's url.Query().Get and pgx read it.
query_param() { # <url> <name>
  local q="${1#*\?}" pair
  [[ "$q" != "$1" ]] || return 0
  local IFS='&'
  for pair in $q; do
    if [[ "$pair" == "$2="* ]]; then
      printf '%s' "${pair#*=}"
      return 0
    fi
  done
}

if [[ ! -f "$env_file" ]]; then
  bad "APP_ENV_FILE $env_file is missing (run deploy/bin/render-env)"
elif [[ ! -r "$env_file" ]]; then
  bad "APP_ENV_FILE $env_file is not readable (run preflight as root)"
else
  [[ "$(mode "$env_file")" =~ ^[0-7]00$ ]] || bad "APP_ENV_FILE must not be readable by group or others (chmod 600)"
  for key in DATABASE_URL WEBHOOK_KEKS; do
    grep -q "^$key=." "$env_file" || bad "APP_ENV_FILE lacks $key"
  done
  # render-env writes KEY='value'.
  db_url=$(sed -n "s/^DATABASE_URL='\(.*\)'\$/\1/p; s/^DATABASE_URL=\([^']*\)\$/\1/p" "$env_file" | head -1)
  [[ "$(query_param "$db_url" sslmode)" == verify-full ]] || bad "DATABASE_URL must use sslmode=verify-full"
  [[ "$(query_param "$db_url" sslrootcert)" == /etc/email-platform/db-ca.pem ]] || bad "DATABASE_URL must set sslrootcert=/etc/email-platform/db-ca.pem"
  unset db_url
fi
[[ -s "$ca_file" ]] || bad "DB_CA_FILE $ca_file is missing or empty"
grep -q "BEGIN CERTIFICATE" "$ca_file" 2>/dev/null || bad "DB_CA_FILE holds no PEM certificate"

if [[ ! -s "$alert_file" ]]; then
  bad "alert receiver $alert_file is missing or empty (Alertmanager would drop every alert silently)"
elif [[ "$(wc -l <"$alert_file" | tr -d ' ')" -gt 1 ]] || ! grep -qE '^https?://[^[:space:]]+$' "$alert_file"; then
  bad "alert receiver file must hold exactly one http(s) URL"
else
  # Alertmanager reads the file only when it notifies: prove now that its
  # image's user can read it through the same read-only mount.
  am_image=$(sed -n 's/^ *image: *\(prom\/alertmanager:[^ ]*\)$/\1/p' "$compose" | head -1)
  if [[ -z "$am_image" ]]; then
    bad "no Alertmanager image in $compose"
  elif ! docker run --rm --network none --read-only --entrypoint cat \
    -v "$(cd "$(dirname "$alert_file")" && pwd):/etc/alertmanager/secrets:ro" \
    "$am_image" /etc/alertmanager/secrets/webhook-url >/dev/null 2>&1; then
    bad "Alertmanager's user cannot read $alert_file (chown 65534 and chmod 0400, directory 0755)"
  fi
  [[ "$(mode "$alert_file")" =~ [0-7][0-7][0-3]$ ]] || echo "preflight: warning: $alert_file is readable by everyone; prefer owner 65534, mode 0400" >&2
fi
[[ -n "${API_DOMAIN:-}" ]] || bad "API_DOMAIN is not set"
[[ -n "${ACME_EMAIL:-}" ]] || bad "ACME_EMAIL is not set"

if [[ $problems -gt 0 ]]; then
  echo "preflight: $problems problem(s); not starting" >&2
  exit 1
fi
echo "preflight: env file, database CA, alert receiver and TLS settings present"
