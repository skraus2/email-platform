# The public site, shared by the production and the deploy-check Caddyfile:
# only the /v1 API and the probes are proxied; the operator API, metrics and
# the dashboard are never reachable through this proxy.
{$API_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}
}
